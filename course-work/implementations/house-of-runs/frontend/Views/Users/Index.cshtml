@model ListPageViewModel<UserResponse>
@{
    ViewData["Title"] = "Users";
}

<section class="hero">
    <h1>Users</h1>
    <p>CRUD page for platform accounts.</p>
    <a class="button primary" asp-action="Create">Create User</a>
</section>

<form asp-action="Index" method="get" class="panel filters">
    <input name="q" maxlength="120" value="@Model.Q" placeholder="Search username, display name, bio" />
    <input name="email" maxlength="120" value="@Model.Filters.GetValueOrDefault("email")" placeholder="Email" />
    <select name="isActive">
        <option value="">Any status</option>
        <option value="true" selected="@(Model.Filters.GetValueOrDefault("isActive") == "True")">Active</option>
        <option value="false" selected="@(Model.Filters.GetValueOrDefault("isActive") == "False")">Inactive</option>
    </select>
    <select name="sortBy">
        <option value="createdAt" selected="@(Model.SortBy == "createdAt")">Created</option>
        <option value="username" selected="@(Model.SortBy == "username")">Username</option>
        <option value="email" selected="@(Model.SortBy == "email")">Email</option>
        <option value="reputation" selected="@(Model.SortBy == "reputation")">Reputation</option>
    </select>
    <select name="sortDir">
        <option value="desc" selected="@(Model.SortDir == "desc")">Descending</option>
        <option value="asc" selected="@(Model.SortDir == "asc")">Ascending</option>
    </select>
    <button type="submit" class="primary">Apply</button>
</form>

<section class="panel table-wrap">
    <table>
        <thead><tr><th>Username</th><th>Display</th><th>Email</th><th>Role</th><th>Reputation</th><th>Active</th><th></th></tr></thead>
        <tbody>
        @foreach (var user in Model.Page.Items)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.DisplayName</td>
                <td>@user.Email</td>
                <td>@user.Role</td>
                <td>@user.Reputation</td>
                <td>@(user.IsActive ? "Yes" : "No")</td>
                <td class="actions">
                    <a class="button" asp-action="Edit" asp-route-id="@user.Id">Edit</a>
                    <form asp-action="Delete" asp-route-id="@user.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</section>

<div class="pagination panel">
    @if (Model.Page.Page > 1)
    {
        <a class="button" asp-route-page="@(Model.Page.Page - 1)" asp-route-q="@Model.Q" asp-route-email="@Model.Filters.GetValueOrDefault("email")" asp-route-isActive="@Model.Filters.GetValueOrDefault("isActive")" asp-route-sortBy="@Model.SortBy" asp-route-sortDir="@Model.SortDir">Previous</a>
    }
    <span class="muted">Page @Model.Page.Page of @Math.Max(1, Model.Page.TotalPages)</span>
    @if (Model.Page.Page < Model.Page.TotalPages)
    {
        <a class="button" asp-route-page="@(Model.Page.Page + 1)" asp-route-q="@Model.Q" asp-route-email="@Model.Filters.GetValueOrDefault("email")" asp-route-isActive="@Model.Filters.GetValueOrDefault("isActive")" asp-route-sortBy="@Model.SortBy" asp-route-sortDir="@Model.SortDir">Next</a>
    }
</div>
